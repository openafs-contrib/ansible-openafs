FROM registry.opensuse.org/opensuse/leap:15.6

# Install documentation files (man pages), which are excluded by the base
# image, so packages are installed as on a regular system.
RUN sed -i 's/^rpm.install.excludedocs.*/rpm.install.excludedocs = no/' /etc/zypp/zypp.conf

# Install python, sudo, and systemd. Install python 3.11, since current
# versions of ansible-core do not support the default python 3.6.
RUN zypper --non-interactive install python311 sudo systemd systemd-sysvinit iproute2 procps hostname && \
    zypper clean --all

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
