# Molecule managed

FROM {{ afs_podman_base_image }}

# Install python, sudo, and systemd. Current versions of ansible-core require
# python 3.8 or later on the managed nodes, so install a newer python on
# platforms which have an older default python version.
RUN if command -v apt-get >/dev/null; then \
        export DEBIAN_FRONTEND=noninteractive; \
        apt-get update && \
        apt-get install -y python3 python3-apt sudo systemd systemd-sysv dbus iproute2 procps ca-certificates && \
        apt-get clean; \
    elif command -v dnf >/dev/null; then \
        if grep -q 'platform:el8' /etc/os-release; then python=python3.12; else python=python3; fi; \
        dnf install -y $python sudo systemd iproute procps-ng hostname && \
        dnf clean all; \
    elif command -v zypper >/dev/null; then \
        if grep -q 'VERSION_ID="15' /etc/os-release; then python=python311; else python=python3; fi; \
        zypper --non-interactive install $python sudo systemd systemd-sysvinit iproute2 procps hostname && \
        zypper clean --all; \
    fi

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
